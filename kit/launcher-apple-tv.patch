@@ -0,0 +1,324 @@
+package com.gathin.tvhome;
+
+import android.app.Activity;
+import android.content.BroadcastReceiver;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.Intent;
+import android.content.IntentFilter;
+import android.database.Cursor;
+import android.graphics.Bitmap;
+import android.graphics.BitmapFactory;
+import android.net.Uri;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.format.DateFormat;
+import android.view.LayoutInflater;
+import android.view.View;
+import android.view.ViewGroup;
+import android.widget.FrameLayout;
+import android.widget.ImageView;
+import android.widget.TextView;
+
+import java.io.InputStream;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.time.ZoneId;
+import java.time.ZonedDateTime;
+import java.time.format.DateTimeFormatter;
+import java.time.format.TextStyle;
+import java.util.HashMap;
+import java.util.Locale;
+import java.util.Map;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+
+/**
+ * Real Madrid's next or live match on Home, from the Real Madrid Live companion app (addons/madrid-live), which owns
+ * the network: this launcher still has no INTERNET permission and only reads the companion's ContentProvider.
+ * Reads run on one background thread, so a cold companion process never stalls Home; any failure keeps what is on
+ * screen, and with no companion (or no match) the panel stays hidden. While a match is live it re-reads every 20 s,
+ * only while Home is showing.
+ */
+final class MatchPanel {
+
+    static final String AUTHORITY = "com.zaid.madridlive.match";
+    static final String ACTION_UPDATED = "com.zaid.madridlive.MATCH_UPDATED";
+    private static final Uri NEXT = Uri.parse("content://" + AUTHORITY + "/next");
+    private static final long LIVE_REFRESH_MS = 20_000;
+    private static final long STALE_MS = 10 * 60_000;
+
+    /** One row of the companion's provider. */
+    static final class Match {
+        String state = "";
+        long kickoffMs;
+        String competition = "", home = "", away = "", homeAbbr = "", awayAbbr = "", clock = "", lastEvent = "";
+        int homeScore = -1, awayScore = -1;
+        long fetchedMs;
+        Bitmap homeCrest, awayCrest;
+
+        boolean live() {
+            return "in".equals(state);
+        }
+
+        boolean finished() {
+            return "post".equals(state);
+        }
+    }
+
+    private final Activity activity;
+    private final View panel;
+    private final View dot;
+    private final TextView kicker, homeName, center, awayName, when;
+    private final ImageView homeCrest, awayCrest;
+    private final Handler handler = new Handler(Looper.getMainLooper());
+    private final ExecutorService io = Executors.newSingleThreadExecutor(r -> {
+        Thread t = new Thread(r, "match-panel");
+        t.setPriority(Thread.MIN_PRIORITY);
+        return t;
+    });
+    /** Crests by team abbreviation, decoded once. */
+    private final Map<String, Bitmap> crests = new HashMap<>();
+    private Match current;
+    private long lastReadMs;
+    private boolean started;
+    private boolean receiverRegistered;
+
+    private final BroadcastReceiver updated = new BroadcastReceiver() {
+        @Override
+        public void onReceive(Context c, Intent i) {
+            refresh();
+        }
+    };
+
+    private final Runnable liveTick = new Runnable() {
+        @Override
+        public void run() {
+            if (!started) return;
+            refresh();
+            handler.postDelayed(this, LIVE_REFRESH_MS);
+        }
+    };
+
+    /** Adds the panel to Home's root, above the cinematic scrim so it stays readable over the artwork. */
+    MatchPanel(Activity activity, FrameLayout root, View above) {
+        this.activity = activity;
+        panel = LayoutInflater.from(activity).inflate(R.layout.match_panel, root, false);
+        int index = above == null ? root.getChildCount() : root.indexOfChild(above) + 1;
+        root.addView(panel, Math.max(0, Math.min(index, root.getChildCount())));
+        dot = panel.findViewById(R.id.matchDot);
+        kicker = panel.findViewById(R.id.matchKicker);
+        homeName = panel.findViewById(R.id.matchHome);
+        center = panel.findViewById(R.id.matchCenter);
+        awayName = panel.findViewById(R.id.matchAway);
+        when = panel.findViewById(R.id.matchWhen);
+        homeCrest = panel.findViewById(R.id.matchHomeCrest);
+        awayCrest = panel.findViewById(R.id.matchAwayCrest);
+    }
+
+    /** Home is showing: listen for the companion's updates and read the row. */
+    void start() {
+        started = true;
+        if (!receiverRegistered) {
+            try {
+                activity.registerReceiver(updated, new IntentFilter(ACTION_UPDATED));
+                receiverRegistered = true;
+            } catch (RuntimeException ignored) {
+                // The minute tick still refreshes.
+            }
+        }
+        refresh();
+        scheduleLive();
+    }
+
+    /** Home is hidden: no reads, no timers. */
+    void stop() {
+        started = false;
+        handler.removeCallbacks(liveTick);
+        if (receiverRegistered) {
+            try {
+                activity.unregisterReceiver(updated);
+            } catch (RuntimeException ignored) {
+            }
+            receiverRegistered = false;
+        }
+    }
+
+    void close() {
+        stop();
+        io.shutdownNow();
+    }
+
+    /** Once a minute with the clock: the countdown moves on; a row older than ten minutes is read again. */
+    void tick() {
+        if (current != null) render(current);
+        if (System.currentTimeMillis() - lastReadMs > STALE_MS) refresh();
+    }
+
+    private void scheduleLive() {
+        handler.removeCallbacks(liveTick);
+        if (started && current != null && current.live()) handler.postDelayed(liveTick, LIVE_REFRESH_MS);
+    }
+
+    void refresh() {
+        if (io.isShutdown()) return;
+        try {
+            io.execute(() -> {
+                Match m = read();
+                handler.post(() -> {
+                    if (activity.isDestroyed()) return;
+                    lastReadMs = System.currentTimeMillis();
+                    boolean wasLive = current != null && current.live();
+                    current = m;
+                    render(m);
+                    if (m != null && m.live() != wasLive) scheduleLive();
+                });
+            });
+        } catch (RuntimeException ignored) {
+            // Executor shut down while Home closed.
+        }
+    }
+
+    /** The companion's row, or null when it is not installed, has no match, or answers with something unexpected. */
+    private Match read() {
+        ContentResolver cr = activity.getContentResolver();
+        try (Cursor c = cr.query(NEXT, null, null, null, null)) {
+            if (c == null || !c.moveToFirst()) return null;
+            Match m = new Match();
+            m.state = str(c, "state");
+            m.kickoffMs = num(c, "kickoff_ms");
+            m.competition = str(c, "competition");
+            m.home = str(c, "home");
+            m.away = str(c, "away");
+            m.homeAbbr = str(c, "home_abbr");
+            m.awayAbbr = str(c, "away_abbr");
+            m.homeScore = (int) num(c, "home_score", -1);
+            m.awayScore = (int) num(c, "away_score", -1);
+            m.clock = str(c, "clock");
+            m.lastEvent = str(c, "last_event");
+            m.fetchedMs = num(c, "fetched_ms");
+            if (m.home.isEmpty() || m.away.isEmpty() || m.kickoffMs <= 0) return null;
+            m.homeCrest = crest(cr, "home", m.homeAbbr);
+            m.awayCrest = crest(cr, "away", m.awayAbbr);
+            return m;
+        } catch (Throwable t) {
+            return current;   // keep what is on screen
+        }
+    }
+
+    private Bitmap crest(ContentResolver cr, String side, String abbr) {
+        String key = abbr.isEmpty() ? side : abbr;
+        Bitmap cached = crests.get(key);
+        if (cached != null) return cached;
+        try (InputStream in = cr.openInputStream(Uri.parse("content://" + AUTHORITY + "/logo/" + side))) {
+            if (in == null) return null;
+            Bitmap b = BitmapFactory.decodeStream(in);
+            if (b != null && !abbr.isEmpty()) crests.put(key, b);
+            return b;
+        } catch (Throwable t) {
+            return null;
+        }
+    }
+
+    private static String str(Cursor c, String col) {
+        int i = c.getColumnIndex(col);
+        if (i < 0 || c.isNull(i)) return "";
+        String s = c.getString(i);
+        return s == null ? "" : s.trim();
+    }
+
+    private static long num(Cursor c, String col) {
+        return num(c, col, 0);
+    }
+
+    private static long num(Cursor c, String col, long fallback) {
+        int i = c.getColumnIndex(col);
+        if (i < 0 || c.isNull(i)) return fallback;
+        try {
+            return c.getLong(i);
+        } catch (RuntimeException e) {
+            return fallback;
+        }
+    }
+
+    private void render(Match m) {
+        if (m == null) {
+            panel.setVisibility(View.GONE);
+            return;
+        }
+        Locale locale = Locale.getDefault();
+        homeName.setText(m.home);
+        awayName.setText(m.away);
+        homeCrest.setImageBitmap(m.homeCrest);
+        homeCrest.setVisibility(m.homeCrest == null ? View.GONE : View.VISIBLE);
+        awayCrest.setImageBitmap(m.awayCrest);
+        awayCrest.setVisibility(m.awayCrest == null ? View.GONE : View.VISIBLE);
+        boolean scored = m.homeScore >= 0 && m.awayScore >= 0;
+        // Scores in Western digits inside a left-to-right isolate: Arabic-Indic digits around a dash are laid out
+        // right to left and "1 – 0" would read "0 – 1".
+        String score = scored ? LRI + String.format(Locale.ROOT, "%d – %d", m.homeScore, m.awayScore) + PDI : "–";
+        if (m.live()) {
+            dot.setVisibility(View.VISIBLE);
+            kicker.setText(join(activity.getString(R.string.match_live), isolate(m.clock)));
+            center.setText(score);
+            when.setText(m.lastEvent.isEmpty() ? m.competition : event(m.lastEvent));
+        } else if (m.finished()) {
+            dot.setVisibility(View.GONE);
+            kicker.setText(join(activity.getString(R.string.match_final), m.competition));
+            center.setText(score);
+            when.setText(event(m.lastEvent));
+            when.setVisibility(m.lastEvent.isEmpty() ? View.GONE : View.VISIBLE);
+        } else {
+            dot.setVisibility(View.GONE);
+            kicker.setText(m.competition);
+            java.text.DateFormat time = DateFormat.getTimeFormat(activity);
+            center.setText(time.format(new java.util.Date(m.kickoffMs)));
+            when.setText(join(dayLabel(m.kickoffMs, locale), countdown(m.kickoffMs - System.currentTimeMillis())));
+        }
+        if (!m.finished()) when.setVisibility(View.VISIBLE);
+        panel.setVisibility(View.VISIBLE);
+    }
+
+    private String dayLabel(long kickoffMs, Locale locale) {
+        ZoneId zone = ZoneId.systemDefault();
+        LocalDate day = Instant.ofEpochMilli(kickoffMs).atZone(zone).toLocalDate();
+        LocalDate today = LocalDate.now(zone);
+        if (day.equals(today)) return activity.getString(R.string.match_today);
+        if (day.equals(today.plusDays(1))) return activity.getString(R.string.match_tomorrow);
+        ZonedDateTime z = Instant.ofEpochMilli(kickoffMs).atZone(zone);
+        if (day.isBefore(today.plusDays(7))) return z.getDayOfWeek().getDisplayName(TextStyle.FULL, locale);
+        return z.format(DateTimeFormatter.ofPattern("EEEE d MMMM", locale));
+    }
+
+    private String countdown(long ms) {
+        if (ms <= 60_000) return activity.getString(R.string.match_kickoff_soon);
+        long minutes = ms / 60_000;
+        if (minutes < 60) return activity.getString(R.string.match_in_minutes, minutes);
+        long hours = minutes / 60;
+        if (hours < 24) return activity.getString(R.string.match_in_hours, hours, minutes % 60);
+        return activity.getString(R.string.match_in_days, hours / 24, hours % 24);
+    }
+
+    /** Unicode first-strong isolates: an English run (a name, a minute) keeps its order inside an Arabic line. */
+    private static final String LRI = "\u2066", PDI = "\u2069";
+
+    private static String isolate(String latin) {
+        return latin == null || latin.isEmpty() ? "" : LRI + latin + PDI;
+    }
+
+    /** The companion's "Goal · Vinícius Jr. 67'": the kind in the TV's language, the rest isolated. */
+    private String event(String e) {
+        if (e == null || e.isEmpty()) return "";
+        int dot = e.indexOf(" · ");
+        if (dot < 0) return isolate(e);
+        String kind = e.substring(0, dot), rest = e.substring(dot + 3);
+        int res = "Goal".equalsIgnoreCase(kind) ? R.string.match_goal : "Red card".equalsIgnoreCase(kind) ? R.string.match_red : 0;
+        return join(res == 0 ? kind : activity.getString(res), isolate(rest));
+    }
+
+    private static String join(String a, String b) {
+        if (b == null || b.isEmpty()) return a;
+        if (a == null || a.isEmpty()) return b;
+        return a + "  ·  " + b;
+    }
+}
diff --git a/launcher/app/src/main/java/com/gathin/tvhome/Sheen.java b/launcher/app/src/main/java/com/gathin/tvhome/Sheen.java
new file mode 100644
index 0000000..6bb2784
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/Sheen.java
@@ -0,0 +1,118 @@
+package com.gathin.tvhome;
+
+import android.animation.ValueAnimator;
+import android.graphics.Canvas;
+import android.graphics.ColorFilter;
+import android.graphics.LinearGradient;
+import android.graphics.Matrix;
+import android.graphics.Paint;
+import android.graphics.PixelFormat;
+import android.graphics.Rect;
+import android.graphics.Shader;
+import android.view.animation.DecelerateInterpolator;
+
+import androidx.annotation.NonNull;
+
+/**
+ * Apple TV focus light (config.xml apple_focus): the card's foreground. While the tile is focused a soft glare lies
+ * over its top half, and on focus one diagonal band of light sweeps across it once, as tvOS icons catch the light.
+ * Both are gradients fixed at their size; the sweep only moves the band's shader matrix, so a frame allocates nothing.
+ * The card clips to its rounded outline, so the light keeps the tile's corners.
+ */
+final class Sheen extends android.graphics.drawable.Drawable {
+
+    private static final int GLARE_MS = 180;
+    private static final int SWEEP_MS = 750;
+    /** The moving band of light. Off: on the Mi TV Stick's Mali-450 it redraws the tile for its whole run. */
+    static final boolean SWEEP = false;
+
+    private final Paint glare = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Paint band = new Paint(Paint.ANTI_ALIAS_FLAG);
+    private final Matrix matrix = new Matrix();
+    private float bandWidth;
+    /** 0 to 1: how much of the glare shows. */
+    private float glareLevel;
+    /** The band's left edge as a share of the travel, or a negative value while no sweep runs. */
+    private float sweep = -1f;
+    private ValueAnimator glareAnim;
+    private ValueAnimator sweepAnim;
+
+    @Override
+    protected void onBoundsChange(@NonNull Rect b) {
+        if (b.isEmpty()) return;
+        glare.setShader(new LinearGradient(0, b.top, 0, b.top + b.height() * 0.6f,
+                0x33FFFFFF, 0x00FFFFFF, Shader.TileMode.CLAMP));
+        bandWidth = b.width() * 0.5f;
+        // Tilted band: the gradient runs along (1, 0.45), so its stripes lean like light across glass.
+        band.setShader(new LinearGradient(0, 0, bandWidth, bandWidth * 0.45f,
+                new int[]{0x00FFFFFF, 0x2EFFFFFF, 0x00FFFFFF}, new float[]{0f, 0.5f, 1f}, Shader.TileMode.CLAMP));
+    }
+
+    /** Focus in: glare up and one sweep; focus out: glare down, sweep stopped. */
+    void focus(boolean focused, boolean animate) {
+        if (glareAnim != null) glareAnim.cancel();
+        if (sweepAnim != null) sweepAnim.cancel();
+        if (!animate) {
+            glareLevel = focused ? 1f : 0f;
+            sweep = -1f;
+            invalidateSelf();
+            return;
+        }
+        glareAnim = ValueAnimator.ofFloat(glareLevel, focused ? 1f : 0f);
+        glareAnim.setDuration(focused ? GLARE_MS : 120);
+        glareAnim.addUpdateListener(a -> {
+            glareLevel = (float) a.getAnimatedValue();
+            invalidateSelf();
+        });
+        glareAnim.start();
+        if (!focused || !SWEEP) {
+            sweep = -1f;
+            return;
+        }
+        sweepAnim = ValueAnimator.ofFloat(0f, 1f);
+        sweepAnim.setDuration(SWEEP_MS);
+        sweepAnim.setStartDelay(60);
+        sweepAnim.setInterpolator(new DecelerateInterpolator(1.4f));
+        sweepAnim.addUpdateListener(a -> {
+            sweep = (float) a.getAnimatedValue();
+            invalidateSelf();
+        });
+        sweepAnim.addListener(new android.animation.AnimatorListenerAdapter() {
+            @Override
+            public void onAnimationEnd(android.animation.Animator a) {
+                sweep = -1f;
+                invalidateSelf();
+            }
+        });
+        sweepAnim.start();
+    }
+
+    @Override
+    public void draw(@NonNull Canvas canvas) {
+        Rect b = getBounds();
+        if (b.isEmpty()) return;
+        if (glareLevel > 0f) {
+            glare.setAlpha(Math.round(255 * glareLevel));
+            canvas.drawRect(b, glare);
+        }
+        if (sweep >= 0f && band.getShader() != null) {
+            float x = b.left - bandWidth * 1.4f + sweep * (b.width() + bandWidth * 2f);
+            matrix.setTranslate(x, b.top);
+            band.getShader().setLocalMatrix(matrix);
+            canvas.drawRect(b, band);
+        }
+    }
+
+    @Override
+    public void setAlpha(int alpha) {
+    }
+
+    @Override
+    public void setColorFilter(ColorFilter colorFilter) {
+    }
+
+    @Override
+    public int getOpacity() {
+        return PixelFormat.TRANSLUCENT;
+    }
+}
